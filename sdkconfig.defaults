# Applied only when sdkconfig is generated fresh. To pick these up on an
# existing tree, delete sdkconfig (or run `idf.py fullclean`) before building.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y

# Wi-Fi + httpd + NimBLE outgrows the 1 MB factory partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# BLE peripheral for the phone app, one connection, bonds kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
